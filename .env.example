# Copy to .env.local and fill in locally. Never commit real values.
# Production values are managed in the Vercel project settings, not here.

# --- Supabase (public, safe to expose) -------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Supabase (server-only secret) ----------------------------------
# Project settings -> API -> service_role key
# Only needed for server-side analytics writes (/api/page-visit, /api/tool-events)
# and the /admin dashboard. Registration, login and all public tools work without it.
SUPABASE_SECRET_KEY=

# --- Admin ------------------------------------------------------------
# The UUID of the one account allowed to open /admin. Compared exactly against
# the signed-in user's id, so a wrong value silently redirects to /dashboard
# with no error. It changes whenever you move Supabase projects, because a
# re-registered account gets a new UUID.
ADMIN_USER_ID=

# --- Site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional integrations (leave blank to disable) ------------------
# Google PageSpeed Insights API key (page-speed tool real metrics)
GOOGLE_PAGESPEED_API_KEY=
# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# DataForSEO (keyword data)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Cron protection
CRON_SECRET=

# ---------------------------------------------------------------------------
# Adsterra (temporary advertising experiment)
# ---------------------------------------------------------------------------
# Off by default. When false, no ad component renders and no request is made to
# any ad network. Set to "true" to enable ads, and back to "false" (or delete
# the variable) to return the site to an ad-free state before a Google AdSense
# review. See docs/ads.md for the full switch-on / switch-off procedure.
NEXT_PUBLIC_ADSTERRA_ENABLED=false
