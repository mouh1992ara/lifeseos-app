# Copy to .env.local and fill in locally. Never commit real values.
# Production values are managed in the Vercel project settings, not here.

# --- Supabase (public, safe to expose) -------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Supabase (server-only secret) ----------------------------------
# Project settings -> API -> service_role key
# Only needed for server-side analytics writes (/api/page-visit, /api/tool-events)
# and the /admin dashboard. Registration, login and all public tools work without it.
SUPABASE_SECRET_KEY=

# --- Site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional integrations (leave blank to disable) ------------------
# Google PageSpeed Insights API key (page-speed tool real metrics)
GOOGLE_PAGESPEED_API_KEY=
# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# DataForSEO (keyword data)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Admin access + cron protection
ADMIN_USER_ID=
CRON_SECRET=
